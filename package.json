{
  "name": "@agegr/activity-agent",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 30142",
    "dev:eval:loop": "NEXT_DIST_DIR=.next-eval-loop EVAL_CONTROL_VARIANT=observe_only EVAL_ALLOW_UNSAFE_BASELINE=1 next dev -p 30143",
    "build": "next build --webpack",
    "start": "next start -p 30142",
    "lint": "eslint .",
    "test:smoke": "tsx scripts/p0-smoke-test.ts",
    "e2e:real": "tsx scripts/e2e-real-llm-test.ts",
    "e2e": "tsx scripts/e2e-with-server.ts",
    "e2e:auth": "tsx scripts/e2e-auth-test.ts",
    "test:visual": "playwright test",
    "eval:candidates": "tsx scripts/candidate-diversity-eval.ts",
    "eval:routes": "tsx scripts/v3-route-eval.ts",
    "eval:quality": "tsx scripts/v5-quality-eval.ts",
    "test:eval:v1": "tsx scripts/eval-v1-contract-test.ts",
    "eval:agent:v1": "tsx scripts/eval-agent-v1.ts",
    "eval:agent:ab": "node --import tsx scripts/eval-agent-ab.ts",
    "test:eval:ab": "node --import tsx scripts/eval-ab-contract-test.ts",
    "eval:intent-routing": "tsx scripts/eval-intent-routing.ts",
    "test:eval:v2": "tsx scripts/eval-v2-contract-test.ts",
    "eval:review:v2": "tsx scripts/eval-review-v2.ts",
    "eval:judge:v2": "tsx scripts/eval-judge-v2.ts",
    "test:provider": "tsx scripts/amap-provider-contract-test.ts",
    "test:amap": "tsx scripts/validate-amap.ts && tsx scripts/v3-route-eval.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@lobehub/icons": "^5.6.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
