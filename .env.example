# activity-agent 环境变量清单（阶段 2）
#
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：next dev 会自动加载 .env；tsx 脚本（db:migrate / smoke）通过
# process.loadEnvFile() 自行加载。
#
# ─── T0/T1 · PostgreSQL ───────────────────────────────────────────
# 与 docker-compose.dev.yml 的默认账号一致（端口 55432 非默认，避免冲突）
DATABASE_URL=postgres://activity:activity_dev@localhost:55432/activity_agent

# 存储后端开关：file = 阶段 1 行为（默认，无需 Docker）；postgres = T1 后启用
STORAGE_BACKEND=file

# ─── T0/T2 · Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# 速率限制（T2 交付）：false 时完全跳过（e2e/smoke 默认不受影响）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MSGS_PER_MIN=20

# ─── T3 · 认证 ────────────────────────────────────────────────────
# disabled = 纯本地（v3 链：header > cookie > OS）
# optional = 有 NextAuth session 用之，否则回落 v3 链（默认，e2e 兼容）
# required = 未登录一律 401/重定向 /login；忽略 X-User-Id / pi_user
AUTH_MODE=optional
# 生成：openssl rand -base64 32
AUTH_SECRET=
