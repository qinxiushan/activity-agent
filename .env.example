# activity-agent 环境变量清单（阶段 2）
#
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：next dev 会自动加载 .env；tsx 脚本（db:migrate / smoke）通过
# process.loadEnvFile() 自行加载。
#
# ─── T0/T1 · PostgreSQL ───────────────────────────────────────────
# 与 docker-compose.dev.yml 的默认账号一致（端口 55432 非默认，避免冲突）
DATABASE_URL=postgres://activity:activity_dev@localhost:55432/activity_agent

# 存储后端开关：file = 阶段 1 行为（默认，无需 Docker）；postgres = T1 后启用
STORAGE_BACKEND=file

# ─── T0/T2 · Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# 速率限制（T2 交付）：false 时完全跳过（e2e/smoke 默认不受影响）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MSGS_PER_MIN=20

# ─── T3 · 认证 ────────────────────────────────────────────────────
# disabled = 纯本地（v3 链：header > cookie > OS）
# optional = 有签名登录 session 用之，否则回落 v3 链（默认，e2e 兼容）
# required = 未登录一律 401/重定向 /login；忽略 X-User-Id / pi_user
AUTH_MODE=optional
# 生成：openssl rand -base64 32
AUTH_SECRET=

# ─── 真实位置与 POI 数据 ──────────────────────────────────────────
# mock = 北京/上海/深圳本地数据；amap = 高德全国 REST 数据
DATA_SOURCE=mock
AMAP_MAPS_API_KEY=
# allow_mock：高德失败时返回明确标记的 mock 降级数据（适合本地开发）
# fail_closed：高德缺少 key 或请求失败时直接返回结构化不可用（生产默认）
DATA_FALLBACK_POLICY=allow_mock

# 仅在应用位于你控制的反向代理之后时开启。开启后服务端才读取
# CF-Connecting-IP / X-Real-IP / X-Forwarded-For，并只保留公网 IP。
# 原始 IP 仅用于当前 session 的城市级定位，不持久化、不返回模型。
TRUST_PROXY_HEADERS=false

# ─── T4 · Docker 全栈 ─────────────────────────────────────────────
# docker compose 默认也读取 AUTH_SECRET；留空时 compose 会回落到
# compose-dev-secret-change-me，仅适合本机试跑
# 若要让容器内 LLM 可用，需把 ~/.pi/agent/auth.json / settings.json /
# models.json 放进命名卷（见 AGENTS.md 的 Docker 段）
